# Settings and secrets. On Cloudflare, add these in the Worker's Settings, Variables and Secrets.
# For local testing, copy this file to .dev.vars (it is never committed).

# Turns on live mode. Set as a BUILD variable in Cloudflare (it's read when the app is built).
NEXT_PUBLIC_LIVE=true

# Who is on the REPS team (comma separated). They can always sign in and see the agency side.
ADMIN_EMAILS=james@fitpreneuragency.com

# The dashboard's address, used in sign-in emails (optional; defaults to the address it's opened at)
APP_URL=

# Sign-in and invite emails, sent through resend.com (free tier is plenty)
RESEND_API_KEY=
EMAIL_FROM=REPS <hello@yourdomain.com>

# Claude writes the sites, pre-reg pages, emails, amends and voice profiles
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Google Meet transcripts: the Apps Script sends this with each doc (any long random string)
MEETINGS_SECRET=
# Your own email domains, so REPS team addresses never match a client (comma separated)
REPS_EMAIL_DOMAINS=fitpreneuragency.com
