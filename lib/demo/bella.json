{"sha": "7088642fc66d98b675d55a04d794722f23b7c972", "message": "Add Berri landing page", "url": "https://github.com/repshealth/bella/commit/7088642fc66d98b675d55a04d794722f23b7c972", "files": [{"path": "index.html", "html": "<!doctype html>\n<html lang=\"en-GB\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Berri | Train smarter. Know why.</title>\n<meta name=\"description\" content=\"Berri is Bela Fernandez's training app for women: structured strength training, realistic nutrition and the science behind every part of your plan.\">\n<meta property=\"og:title\" content=\"Berri | Train smarter. Know why.\">\n<meta property=\"og:description\" content=\"Stop second guessing every workout. Structured training, realistic nutrition and the why behind it all.\">\n<meta property=\"og:image\" content=\"images/bela_hero.jpg\">\n<meta name=\"theme-color\" content=\"#8976ff\">\n<link rel=\"icon\" type=\"image/png\" href=\"images/icon_blue.png\">\n<link rel=\"apple-touch-icon\" href=\"images/icon_blue.png\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&amp;family=Outfit:wght@400;500;600;700;800&amp;display=swap\" rel=\"stylesheet\">\n<style>\nbody{margin:0;background:#fffdf6}\na{color:#1b1b1b}a:hover{color:#6a55f0}\n.ol{font-family:Fredoka,'Arial Rounded MT Bold',system-ui,sans-serif;font-weight:700;color:#fffdc4;-webkit-text-stroke:4px #1b1b1b;paint-order:stroke fill;letter-spacing:.01em;text-transform:uppercase;line-height:.98;margin:0}\n.ol-dark{font-family:Fredoka,'Arial Rounded MT Bold',system-ui,sans-serif;font-weight:700;color:#1b1b1b;text-transform:uppercase;line-height:.98;margin:0;letter-spacing:.01em}\n.eyebrow{font-family:Outfit,system-ui,sans-serif;font-weight:700;font-size:13px;letter-spacing:.22em;text-transform:uppercase;margin:0}\n.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:52px;padding:0 28px;border:3px solid #1b1b1b;border-radius:999px;background:#fffdc4;color:#1b1b1b;font-family:Outfit,system-ui,sans-serif;font-weight:800;font-size:16px;letter-spacing:.06em;text-transform:uppercase;text-decoration:none;box-shadow:4px 4px 0 #1b1b1b;cursor:pointer;box-sizing:border-box}\n.btn:hover{transform:translate(-1px,-1px);box-shadow:6px 6px 0 #1b1b1b;color:#1b1b1b}\n.btn-ghost{background:#fffdf6}\n.card{background:#fffdf6;border:3px solid #1b1b1b;border-radius:28px;box-shadow:6px 6px 0 #1b1b1b;box-sizing:border-box}\n.ph{display:flex;align-items:center;justify-content:center;text-align:center;font-family:Outfit,system-ui,sans-serif;font-weight:700;font-size:13px;letter-spacing:.14em;text-transform:uppercase;color:#4a3fb0;background:repeating-linear-gradient(135deg,#998dff22 0 14px,#998dff44 14px 28px);border:3px dashed #8976ff;border-radius:24px;box-sizing:border-box}\n.phone{position:relative;width:260px;height:540px;max-width:100%;background:#1b1b1b;border:3px solid #1b1b1b;border-radius:46px;padding:10px;box-sizing:border-box;box-shadow:8px 8px 0 #1b1b1b;flex:0 0 auto}\n.shot{display:block;width:100%;height:100%;object-fit:cover;object-position:top;border-radius:36px;background:#fff}\n.screen{width:100%;height:100%;border-radius:36px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;text-align:center;padding:24px;box-sizing:border-box;font-family:Outfit,system-ui,sans-serif;font-weight:700;font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:#1b1b1b;background:#fffdf6}\n.screen span{display:block;font-family:Fredoka,system-ui,sans-serif;font-size:20px;letter-spacing:.02em}\n.marq{display:flex;gap:40px;white-space:nowrap;animation:mq 30s linear infinite}\n@keyframes mq{from{transform:translateX(0)}to{transform:translateX(-50%)}}\n@media (prefers-reduced-motion:reduce){.marq{animation:none}}\n@media (max-width:760px){.ol{-webkit-text-stroke:3px #1b1b1b}}\n.faq{background:#fffdf6;border:3px solid #1b1b1b;border-radius:20px;box-shadow:4px 4px 0 #1b1b1b;overflow:hidden}\n.faq summary{list-style:none;display:flex;justify-content:space-between;align-items:center;gap:16px;padding:20px 24px;min-height:64px;box-sizing:border-box;cursor:pointer;font-family:Outfit,sans-serif;font-weight:700;font-size:18px;color:#1b1b1b}\n.faq summary::-webkit-details-marker{display:none}\n.faq-icon{flex:0 0 32px;height:32px;border-radius:50%;border:2px solid #1b1b1b;background:#fffdc4;display:flex;align-items:center;justify-content:center;font-size:20px}\n.faq-icon::after{content:\"+\"}.faq[open] .faq-icon::after{content:\"\\2212\"}\n.faq p{margin:0;padding:0 24px 22px;font-size:16px;line-height:1.6}\na:focus-visible,summary:focus-visible,button:focus-visible,input:focus-visible{outline:3px solid #ff93d2;outline-offset:3px}\nhtml{scroll-behavior:smooth;scroll-padding-top:0}\n@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}\n</style>\n</head>\n<body>\n<div style=\"font-family: Outfit, system-ui, sans-serif; color: #1b1b1b; background: #fffdf6; overflow: hidden\">\n\n<!-- HERO -->\n<section id=\"top\" style=\"background: #8976ff; position: relative; border-bottom: 3px solid #1b1b1b\">\n<div style=\"max-width: 1240px; margin: 0 auto; padding: 32px 24px 0\"><img src=\"images/logo_lower.png\" alt=\"berri\" style=\"height: 52px; width: auto; display: block\"></div>\n<div style=\"max-width: 1240px; margin: 0 auto; padding: 40px 24px 88px; display: flex; flex-wrap: wrap; gap: 48px; align-items: center\">\n<div style=\"flex: 1 1 520px; display: flex; flex-direction: column; gap: 28px; min-width: 0\">\n<div style=\"display: inline-flex; align-self: flex-start; align-items: center; gap: 10px; background: #fffdc4; border: 3px solid #1b1b1b; border-radius: 999px; padding: 8px 16px; font-weight: 700; font-size: 14px\">\n<span style=\"width: 10px; height: 10px; border-radius: 50%; background: #ff93d2; border: 2px solid #1b1b1b\"></span>\nLooks sweet. Knows better.\n</div>\n<h1 class=\"ol\" style=\"font-size: clamp(52px, 7.4vw, 104px)\">Train smarter.<br>Know why.</h1>\n<p style=\"margin: 0; font-size: 20px; line-height: 1.55; color: #1b1b1b; max-width: 540px; font-weight: 500\">Stop second guessing every workout. Structured strength training, realistic nutrition and the science behind all of it, so you know exactly why you're doing it. No extreme rules, no quick fixes, no generic plans. From \u00a316.99 a month, first [X] days free.</p>\n<div style=\"display: flex; flex-wrap: wrap; gap: 16px\">\n<a class=\"btn\" href=\"#plan\">Build my plan</a>\n<a class=\"btn btn-ghost\" href=\"#inside\">See what's inside</a>\n</div>\n<div style=\"display: flex; flex-wrap: wrap; gap: 10px 22px; font-weight: 700; font-size: 14px; letter-spacing: .08em; text-transform: uppercase\">\n<span>\u2713 Gym + home plans</span><span>\u2713 Cancel anytime</span><span>\u2713 iOS &amp; Android</span>\n</div>\n</div>\n<div style=\"flex: 1 1 420px; display: flex; justify-content: center; position: relative; min-width: 0\">\n<div style=\"position: relative; width: 100%; max-width: 500px; height: 600px\">\n<img src=\"images/bela_hero.jpg\" alt=\"Bela Fernandez\" style=\"position: absolute; left: 0; top: 0; width: 72%; height: 560px; object-fit: cover; object-position: center 20%; border: 3px solid #1b1b1b; border-radius: 24px; box-shadow: 8px 8px 0 #1b1b1b; box-sizing: border-box; display: block\">\n<div class=\"phone\" style=\"position: absolute; right: 0; bottom: 0; transform: rotate(4deg)\"><img class=\"shot\" src=\"images/shot_home.jpg\" alt=\"Berri app home screen with today's workout and meal plan\"></div>\n</div>\n<img src=\"images/strawberry.png\" alt=\"\" style=\"position: absolute; width: 130px; top: -24px; left: 2%; transform: rotate(-14deg)\">\n<img src=\"images/cherry.png\" alt=\"\" style=\"position: absolute; width: 120px; bottom: -30px; right: 2%; transform: rotate(10deg)\">\n</div>\n</div>\n</section>\n\n<!-- MARQUEE -->\n<div style=\"background: #ff93d2; border-bottom: 3px solid #1b1b1b; padding: 16px 0; overflow: hidden\">\n<div class=\"marq\" style=\"font-family: Fredoka, system-ui, sans-serif; font-weight: 700; font-size: 22px; text-transform: uppercase; color: #1b1b1b\">\n<span>Science-backed \u2726</span><span>Built for women \u2726</span><span>Gym + home \u2726</span><span>Learn the why \u2726</span><span>Plans that progress \u2726</span><span>Sweet science \u2726</span>\n<span>Science-backed \u2726</span><span>Built for women \u2726</span><span>Gym + home \u2726</span><span>Learn the why \u2726</span><span>Plans that progress \u2726</span><span>Sweet science \u2726</span>\n</div>\n</div>\n\n<!-- WHAT BERRI IS -->\n<section style=\"background: #fffdf6\">\n<div style=\"max-width: 1240px; margin: 0 auto; padding: 104px 24px; display: flex; flex-wrap: wrap; gap: 56px; align-items: center\">\n<div style=\"flex: 1 1 520px; display: flex; flex-direction: column; gap: 24px; min-width: 0\">\n<p class=\"eyebrow\" style=\"color: #6a55f0\">What Berri is</p>\n<h2 class=\"ol\" style=\"font-size: clamp(40px, 5vw, 68px); color: #998dff\">Your training,<br>explained.</h2>\n<p style=\"margin: 0; font-size: 19px; line-height: 1.6; max-width: 560px\">Berri helps women go from jumping between conflicting advice to training with confidence. Bela writes the plan and explains the purpose behind every exercise, and the app keeps your training, nutrition and progress in one place.</p>\n<p style=\"margin: 0; font-size: 19px; line-height: 1.6; max-width: 560px\">You won't just be handed a workout and told to get on with it. You'll understand what you're training, how progression works and how it all fits the bigger goal. That's what builds results that last.</p>\n<div style=\"display: flex; flex-wrap: wrap; gap: 16px; margin-top: 8px\">\n<div class=\"card\" style=\"padding: 18px 22px; flex: 1 1 140px; background: #fffdc4\"><div style=\"font-family: Fredoka, sans-serif; font-weight: 700; font-size: 34px\">2\u20134</div><div style=\"font-weight: 600; font-size: 14px\">days a week</div></div>\n<div class=\"card\" style=\"padding: 18px 22px; flex: 1 1 140px; background: #dfffcd\"><div style=\"font-family: Fredoka, sans-serif; font-weight: 700; font-size: 34px\">Gym + home</div><div style=\"font-weight: 600; font-size: 14px\">every plan</div></div>\n<div class=\"card\" style=\"padding: 18px 22px; flex: 1 1 140px; background: #ffb7f1\"><div style=\"font-family: Fredoka, sans-serif; font-weight: 700; font-size: 34px\">6 Qs</div><div style=\"font-weight: 600; font-size: 14px\">to your plan</div></div>\n</div>\n</div>\n<div style=\"flex: 1 1 400px; min-width: 0; display: flex; justify-content: center\">\n<div style=\"display: flex; justify-content: center; align-items: flex-end; gap: 0; flex-wrap: nowrap\">\n<div class=\"phone\" style=\"transform: rotate(-6deg) translateX(24px); z-index: 1\"><img class=\"shot\" src=\"images/shot_tracker.jpg\" alt=\"Workout tracker showing the week's exercises\"></div>\n<div class=\"phone\" style=\"transform: rotate(5deg) translateX(-24px) translateY(-30px); z-index: 2\"><img class=\"shot\" src=\"images/shot_meals.jpg\" alt=\"Meal plan with breakfast, lunch and dinner and their macros\"></div>\n</div>\n</div>\n</div>\n</section>\n\n<!-- WHAT'S INSIDE -->\n<section id=\"inside\" style=\"background: #fffdc4; border-top: 3px solid #1b1b1b; border-bottom: 3px solid #1b1b1b\">\n<div style=\"max-width: 1240px; margin: 0 auto; padding: 104px 24px; display: flex; flex-direction: column; gap: 48px\">\n<div style=\"display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 24px\">\n<div style=\"display: flex; flex-direction: column; gap: 16px\">\n<p class=\"eyebrow\" style=\"color: #6a55f0\">What's inside the membership</p>\n<h2 class=\"ol\" style=\"font-size: clamp(40px, 5vw, 68px); color: #8976ff\">Everything.<br>One app.</h2>\n</div>\n<p style=\"margin: 0; font-size: 18px; line-height: 1.55; max-width: 380px\">Six things you get from day one. Nothing locked behind a higher tier, because there isn't one.</p>\n</div>\n<div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px\">\n<div class=\"card\" style=\"padding: 30px; display: flex; flex-direction: column; gap: 12px\"><div style=\"font-family: Fredoka, sans-serif; font-weight: 700; font-size: 18px; color: #6a55f0\">01</div><h3 style=\"margin: 0; font-family: Fredoka, sans-serif; font-weight: 700; font-size: 26px; text-transform: uppercase\">Training that progresses</h3><p style=\"margin: 0; font-size: 16px; line-height: 1.55\">Structured gym and home plans with sets, reps and suggested weights based on what you actually lifted last week.</p></div>\n<div class=\"card\" style=\"padding: 30px; display: flex; flex-direction: column; gap: 12px; background: #8976ff\"><div style=\"font-family: Fredoka, sans-serif; font-weight: 700; font-size: 18px; color: #fffdc4\">02</div><h3 style=\"margin: 0; font-family: Fredoka, sans-serif; font-weight: 700; font-size: 26px; text-transform: uppercase; color: #fffdc4\">The why, built in</h3><p style=\"margin: 0; font-size: 16px; line-height: 1.55; color: #1b1b1b; font-weight: 500\">Every exercise and every block comes with a short explanation from Bela, so you understand what it's doing and why it's there.</p></div>\n<div class=\"card\" style=\"padding: 30px; display: flex; flex-direction: column; gap: 12px\"><div style=\"font-family: Fredoka, sans-serif; font-weight: 700; font-size: 18px; color: #6a55f0\">03</div><h3 style=\"margin: 0; font-family: Fredoka, sans-serif; font-weight: 700; font-size: 26px; text-transform: uppercase\">Berri Learn</h3><p style=\"margin: 0; font-size: 16px; line-height: 1.55\">Deep Dives on fat loss, glutes and recomp. Pick your topic, unlock a new lesson every 1\u20137 days and keep every one forever.</p></div>\n<div class=\"card\" style=\"padding: 30px; display: flex; flex-direction: column; gap: 12px; background: #ffb7f1\"><div style=\"font-family: Fredoka, sans-serif; font-weight: 700; font-size: 18px; color: #6a55f0\">04</div><h3 style=\"margin: 0; font-family: Fredoka, sans-serif; font-weight: 700; font-size: 26px; text-transform: uppercase\">Nutrition without the faff</h3><p style=\"margin: 0; font-size: 16px; line-height: 1.55\">Calorie and macro targets set for you, a barcode scanner and recipes you'll actually want to make. Realistic, not extreme.</p></div>\n<div class=\"card\" style=\"padding: 30px; display: flex; flex-direction: column; gap: 12px\"><div style=\"font-family: Fredoka, sans-serif; font-weight: 700; font-size: 18px; color: #6a55f0\">05</div><h3 style=\"margin: 0; font-family: Fredoka, sans-serif; font-weight: 700; font-size: 26px; text-transform: uppercase\">Cycle &amp; habit tracking</h3><p style=\"margin: 0; font-size: 16px; line-height: 1.55\">Train with your cycle, not against it. Water, steps, sleep and protein in one dashboard, with streaks that don't punish a missed day.</p></div>\n<div class=\"card\" style=\"padding: 30px; display: flex; flex-direction: column; gap: 12px; background: #dfffcd\"><div style=\"font-family: Fredoka, sans-serif; font-weight: 700; font-size: 18px; color: #6a55f0\">06</div><h3 style=\"margin: 0; font-family: Fredoka, sans-serif; font-weight: 700; font-size: 26px; text-transform: uppercase\">Community &amp; challenges</h3><p style=\"margin: 0; font-size: 16px; line-height: 1.55\">A supportive community of women training alongside you, with challenges that give you something to work towards.</p></div>\n</div>\n<div style=\"display: flex; justify-content: center\"><a class=\"btn\" href=\"#routes\" style=\"background: #8976ff; color: #fffdc4\">Start my plan</a></div>\n</div>\n</section>\n\n<!-- IN THE APP -->\n<section style=\"background: #fffdf6\">\n<div style=\"max-width: 1240px; margin: 0 auto; padding: 104px 24px; display: flex; flex-direction: column; gap: 40px\">\n<div style=\"display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 24px\">\n<div style=\"display: flex; flex-direction: column; gap: 16px\">\n<p class=\"eyebrow\" style=\"color: #6a55f0\">Inside the app</p>\n<h2 class=\"ol\" style=\"font-size: clamp(36px, 4.4vw, 60px); color: #ff93d2\">Everything you need,<br>right in your pocket.</h2>\n</div>\n<p style=\"margin: 0; font-size: 18px; line-height: 1.55; max-width: 380px\">\"I never want someone to open a plan, copy the movements and have no idea why they are there.\" <strong>Bela</strong></p>\n</div>\n<div style=\"display: flex; flex-wrap: wrap; justify-content: center; gap: 32px; padding: 12px 0 20px\">\n<div class=\"phone\"><img class=\"shot\" src=\"images/shot_log.jpg\" alt=\"Exercise logger with demo video, weights, reps and rest timer\"></div>\n<div class=\"phone\" style=\"transform: translateY(28px)\"><img class=\"shot\" src=\"images/shot_meals.jpg\" alt=\"Meal plan options with macros\"></div>\n<div class=\"phone\"><img class=\"shot\" src=\"images/shot_habits.jpg\" alt=\"Cycle tracker, daily tasks and habit tracking\"></div>\n<div class=\"phone\" style=\"transform: translateY(28px)\"><img class=\"shot\" src=\"images/shot_newhabit.jpg\" alt=\"Choosing a new habit to track\"></div>\n</div>\n<div style=\"display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; font-weight: 600; font-size: 15px\">\n<span style=\"border: 2px solid #1b1b1b; border-radius: 999px; padding: 10px 18px; background: #fffdc4\">Workout logger</span>\n<span style=\"border: 2px solid #1b1b1b; border-radius: 999px; padding: 10px 18px; background: #dfffcd\">Meal plans</span>\n<span style=\"border: 2px solid #1b1b1b; border-radius: 999px; padding: 10px 18px; background: #ffb7f1\">Food scanner</span>\n<span style=\"border: 2px solid #1b1b1b; border-radius: 999px; padding: 10px 18px; background: #998dff\">Apple &amp; Google Health</span>\n<span style=\"border: 2px solid #1b1b1b; border-radius: 999px; padding: 10px 18px; background: #fffdc4\">PRs &amp; history</span>\n<span style=\"border: 2px solid #1b1b1b; border-radius: 999px; padding: 10px 18px; background: #dfffcd\">Progress photos</span>\n<span style=\"border: 2px solid #1b1b1b; border-radius: 999px; padding: 10px 18px; background: #ffb7f1\">Habit tracking</span>\n<span style=\"border: 2px solid #1b1b1b; border-radius: 999px; padding: 10px 18px; background: #998dff\">Check-ins</span>\n<span style=\"border: 2px solid #1b1b1b; border-radius: 999px; padding: 10px 18px; background: #fffdc4\">Period tracker</span>\n<span style=\"border: 2px solid #1b1b1b; border-radius: 999px; padding: 10px 18px; background: #dfffcd\">Injury system</span>\n</div>\n</div>\n</section>\n\n<!-- PLAN FUNNEL -->\n<section id=\"plan\" style=\"background: #8976ff; border-top: 3px solid #1b1b1b; border-bottom: 3px solid #1b1b1b\">\n<div style=\"max-width: 1240px; margin: 0 auto; padding: 104px 24px; display: flex; flex-direction: column; gap: 48px\">\n<div style=\"display: flex; flex-direction: column; gap: 16px; align-items: center; text-align: center\">\n<p class=\"eyebrow\" style=\"color: #fffdc4\">Your plan in six questions</p>\n<h2 class=\"ol\" style=\"font-size: clamp(40px, 5vw, 72px)\">Tell us you.<br>We'll build it.</h2>\n<p style=\"margin: 0; font-size: 18px; line-height: 1.55; max-width: 560px; font-weight: 500\">Answer six quick questions and Berri matches you to the right programme, split and level. Takes about two minutes.</p>\n</div>\n<div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 24px\">\n<div class=\"card\" style=\"padding: 28px; display: flex; flex-direction: column; gap: 16px\"><p class=\"eyebrow\" style=\"color: #6a55f0\">01 \u00b7 Goal</p><h3 style=\"margin: 0; font-family: Fredoka, sans-serif; font-size: 24px; font-weight: 700\">What's your goal right now?</h3><div style=\"display: flex; flex-wrap: wrap; gap: 8px\"><span style=\"background: #8976ff; color: #fffdc4; border: 2px solid #1b1b1b; border-radius: 12px; padding: 8px 14px; font-weight: 700\">Fat loss</span><span style=\"background: #8976ff; color: #fffdc4; border: 2px solid #1b1b1b; border-radius: 12px; padding: 8px 14px; font-weight: 700\">Recomp</span><span style=\"background: #8976ff; color: #fffdc4; border: 2px solid #1b1b1b; border-radius: 12px; padding: 8px 14px; font-weight: 700\">Muscle gain</span></div></div>\n<div class=\"card\" style=\"padding: 28px; display: flex; flex-direction: column; gap: 16px\"><p class=\"eyebrow\" style=\"color: #6a55f0\">02 \u00b7 Focus</p><h3 style=\"margin: 0; font-family: Fredoka, sans-serif; font-size: 24px; font-weight: 700\">What do you want to focus on?</h3><div style=\"display: flex; flex-wrap: wrap; gap: 8px\"><span style=\"background: #ffb7f1; border: 2px solid #1b1b1b; border-radius: 12px; padding: 8px 14px; font-weight: 700\">Glutes</span><span style=\"background: #ffb7f1; border: 2px solid #1b1b1b; border-radius: 12px; padding: 8px 14px; font-weight: 700\">Glutes + abs</span><span style=\"background: #ffb7f1; border: 2px solid #1b1b1b; border-radius: 12px; padding: 8px 14px; font-weight: 700\">Glutes, abs + upper</span></div></div>\n<div class=\"card\" style=\"padding: 28px; display: flex; flex-direction: column; gap: 16px\"><p class=\"eyebrow\" style=\"color: #6a55f0\">03 \u00b7 Days</p><h3 style=\"margin: 0; font-family: Fredoka, sans-serif; font-size: 24px; font-weight: 700\">How many days can you realistically train?</h3><div style=\"display: flex; flex-wrap: wrap; gap: 8px\"><span style=\"background: #fffdc4; border: 2px solid #1b1b1b; border-radius: 12px; padding: 8px 14px; font-weight: 700\">2 days</span><span style=\"background: #fffdc4; border: 2px solid #1b1b1b; border-radius: 12px; padding: 8px 14px; font-weight: 700\">3 days</span><span style=\"background: #fffdc4; border: 2px solid #1b1b1b; border-radius: 12px; padding: 8px 14px; font-weight: 700\">4 days</span></div></div>\n<div class=\"card\" style=\"padding: 28px; display: flex; flex-direction: column; gap: 16px\"><p class=\"eyebrow\" style=\"color: #6a55f0\">04 \u00b7 Setup</p><h3 style=\"margin: 0; font-family: Fredoka, sans-serif; font-size: 24px; font-weight: 700\">Home or gym?</h3><div style=\"display: flex; flex-wrap: wrap; gap: 8px\"><span style=\"background: #dfffcd; border: 2px solid #1b1b1b; border-radius: 12px; padding: 8px 14px; font-weight: 700\">Home</span><span style=\"background: #dfffcd; border: 2px solid #1b1b1b; border-radius: 12px; padding: 8px 14px; font-weight: 700\">Gym</span></div></div>\n<div class=\"card\" style=\"padding: 28px; display: flex; flex-direction: column; gap: 16px\"><p class=\"eyebrow\" style=\"color: #6a55f0\">05 \u00b7 Experience</p><h3 style=\"margin: 0; font-family: Fredoka, sans-serif; font-size: 24px; font-weight: 700\">Where are you starting from?</h3><div style=\"display: flex; flex-wrap: wrap; gap: 8px\"><span style=\"background: #998dff; border: 2px solid #1b1b1b; border-radius: 999px; padding: 8px 14px; font-weight: 700\">Beginner</span><span style=\"background: #998dff; border: 2px solid #1b1b1b; border-radius: 999px; padding: 8px 14px; font-weight: 700\">Intermediate</span><span style=\"background: #998dff; border: 2px solid #1b1b1b; border-radius: 999px; padding: 8px 14px; font-weight: 700\">Advanced</span></div></div>\n<div class=\"card\" style=\"padding: 28px; display: flex; flex-direction: column; gap: 16px\"><p class=\"eyebrow\" style=\"color: #6a55f0\">06 \u00b7 Cardio</p><h3 style=\"margin: 0; font-family: Fredoka, sans-serif; font-size: 24px; font-weight: 700\">How do you feel about cardio?</h3><div style=\"display: flex; flex-wrap: wrap; gap: 8px\"><span style=\"background: #dfffcd; border: 2px solid #1b1b1b; border-radius: 12px; padding: 8px 14px; font-weight: 700\">Yes</span><span style=\"background: #dfffcd; border: 2px solid #1b1b1b; border-radius: 12px; padding: 8px 14px; font-weight: 700\">Only if necessary</span><span style=\"background: #dfffcd; border: 2px solid #1b1b1b; border-radius: 12px; padding: 8px 14px; font-weight: 7