{"sha": "5589bd24f378203592e30103a3e0bcbd51f1ffcb", "message": "Add Josh's Wistia VSL and send opt ins to the REPS dashboard", "url": "https://github.com/repshealth/joshbell/commit/5589bd24f378203592e30103a3e0bcbd51f1ffcb", "files": [{"path": "index.html", "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Lean Body Academy | Get In The Best Shape Of Your Life</title>\n<meta name=\"description\" content=\"Watch Josh Bell's free video and see how he helps guys lose the fat, build real muscle and get in the best shape of their life.\">\n<link rel=\"icon\" href=\"assets/img/logo.png\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;500;600;700;800&display=swap\">\n<link rel=\"stylesheet\" href=\"assets/styles.css\">\n<script src=\"assets/config.js\"></script>\n</head>\n<body>\n\n<!-- HERO: JOSH -->\n<div class=\"hero-josh\">\n  <div class=\"photo-bg\" aria-hidden=\"true\">\n    <img src=\"assets/img/josh.jpg\" alt=\"\">\n    <div class=\"tint\"></div>\n    <div class=\"fade\"></div>\n  </div>\n  <header class=\"nav\">\n    <div class=\"wrap\">\n      <img class=\"logo\" src=\"assets/img/logo.png\" alt=\"Lean Body Academy\">\n      <button type=\"button\" class=\"nav-cta\" data-optin>Watch Free Video</button>\n    </div>\n  </header>\n  <div class=\"wrap hero-copy\">\n    <div class=\"inner\">\n      <span class=\"pill\"><i></i>Free Video From Josh Bell</span>\n      <h1 class=\"disp\">Get In The <span class=\"red\">Best Shape</span> Of Your Life</h1>\n      <p class=\"lede\">Lose the fat, build real muscle and finally look and feel how you want to. Watch the free video to see exactly how Josh does it.</p>\n      <div style=\"margin-top:38px\">\n        <button type=\"button\" class=\"btn\" data-optin>\n          <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"#fff\" aria-hidden=\"true\"><path d=\"M8 5v14l11-7z\"/></svg>\n          Watch The Free Video\n        </button>\n      </div>\n    </div>\n  </div>\n</div>\n\n<main>\n  <!-- LOCKED VIDEO -->\n  <section class=\"hero\" style=\"padding:0 0 120px\">\n    <div class=\"glow\" style=\"top:45%;width:900px;height:480px;opacity:.14\" aria-hidden=\"true\"></div>\n    <div class=\"wrap\" style=\"position:relative\">\n      <span class=\"pill\"><i></i>Free Video</span>\n      <h2 class=\"disp\" style=\"font-size:clamp(36px,4.4vw,64px);line-height:1;margin:22px auto 0;max-width:860px\">How Josh Gets Guys <span class=\"red\">Lean For Good</span></h2>\n\n      <div class=\"video-wrap\" style=\"margin-top:52px\">\n        <div class=\"float l\"><img src=\"assets/img/t10.jpg\" alt=\"Lean Body client transformation\"></div>\n        <div class=\"float r\"><img src=\"assets/img/t04.jpg\" alt=\"Lean Body client transformation\"></div>\n        <div class=\"video-frame\">\n          <button type=\"button\" class=\"vlock\" data-optin aria-label=\"Enter your details to watch the free video\">\n            <img src=\"assets/img/josh.jpg\" alt=\"\">\n            <span class=\"center\">\n              <span class=\"play pulse\">\n                <svg width=\"36\" height=\"36\" viewBox=\"0 0 24 24\" fill=\"#fff\" aria-hidden=\"true\"><path d=\"M8 5v14l11-7z\"/></svg>\n              </span>\n              <span class=\"hint\">\n                <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#FF4545\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"4\" y=\"11\" width=\"16\" height=\"10\" rx=\"2\"/><path d=\"M8 11V7a4 4 0 0 1 8 0v4\"/></svg>\n                Enter your details to watch instantly\n              </span>\n            </span>\n          </button>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- TICKER -->\n  <div class=\"ticker\" aria-hidden=\"true\">\n    <div class=\"marq disp\">\n      <span>Lose Fat</span><span>/</span><span>Build Muscle</span><span>/</span><span>Get Lean</span><span>/</span><span>Feel Confident</span><span>/</span><span>Lean Body Academy</span><span>/</span>\n      <span>Lose Fat</span><span>/</span><span>Build Muscle</span><span>/</span><span>Get Lean</span><span>/</span><span>Feel Confident</span><span>/</span><span>Lean Body Academy</span><span>/</span>\n    </div>\n  </div>\n\n  <!-- TRANSFORMATION COLLAGE -->\n  <section style=\"padding:140px 0\">\n    <div class=\"wrap\">\n      <div style=\"display:flex;justify-content:space-between;align-items:flex-end;gap:30px;flex-wrap:wrap\">\n        <div>\n          <span class=\"pill\"><i></i>Real Lean Body Clients</span>\n          <h2 class=\"disp\" style=\"font-size:clamp(42px,6vw,88px);line-height:.95;margin-top:22px;max-width:760px\">The Proof Is In <span class=\"red\">The Pictures</span></h2>\n        </div>\n        <p class=\"muted\" style=\"font-size:17px;line-height:1.6;max-width:360px\">Real guys, real starting points. Hover to see each result, tap to open it full size.</p>\n      </div>\n      <div class=\"collage\" id=\"collage\" style=\"margin-top:64px\"></div>\n    </div>\n  </section>\n\n  <!-- FINAL CTA -->\n  <section style=\"position:relative;padding:150px 0;border-top:1px solid var(--line)\">\n    <div class=\"photo-bg\" aria-hidden=\"true\">\n      <img src=\"assets/img/josh.jpg\" alt=\"\" loading=\"lazy\" style=\"object-position:60% 30%\">\n      <div class=\"tint\"></div>\n      <div class=\"fade\"></div>\n    </div>\n    <div class=\"wrap\" style=\"position:relative\">\n      <div style=\"max-width:620px\">\n        <h2 class=\"disp\" style=\"font-size:clamp(48px,7vw,108px);line-height:.92\">You Could Be <span class=\"red\">Next</span></h2>\n        <p style=\"font-size:19px;line-height:1.6;color:#D4D4D4;margin-top:24px;max-width:500px\">Watch the free video and see exactly how Josh would get you into the best shape of your life.</p>\n        <div style=\"margin-top:40px\">\n          <button type=\"button\" class=\"btn\" data-optin>\n            <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"#fff\" aria-hidden=\"true\"><path d=\"M8 5v14l11-7z\"/></svg>\n            Watch The Free Video\n          </button>\n        </div>\n      </div>\n    </div>\n  </section>\n</main>\n\n<footer class=\"footer\">\n  <div class=\"wrap\">\n    <img src=\"assets/img/logo.png\" alt=\"Lean Body Academy\">\n    <div><a href=\"#\">Privacy</a> <span style=\"padding:0 8px\">|</span> <a href=\"#\">Terms And Conditions</a></div>\n    <div>\u00a9 <span id=\"yr\">2026</span> Lean Body Academy</div>\n  </div>\n</footer>\n\n<!-- OPT IN POP UP -->\n<div class=\"modal-wrap\" id=\"optin-wrap\">\n  <div class=\"modal\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"optin-title\">\n    <div class=\"card-top\" style=\"left:40px;right:40px\" aria-hidden=\"true\"></div>\n    <button type=\"button\" class=\"modal-close\" id=\"optin-close\" aria-label=\"Close\">\n      <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M18 6L6 18M6 6l12 12\"/></svg>\n    </button>\n    <span class=\"pill\"><i></i>Free Video</span>\n    <h3 id=\"optin-title\" class=\"disp\" style=\"font-size:38px;line-height:1;margin-top:18px\">Where Should We <span class=\"red\">Send It?</span></h3>\n    <p class=\"muted\" style=\"font-size:15px;line-height:1.6;margin-top:12px\">Enter your details below to unlock the video instantly.</p>\n    <form id=\"optin\" style=\"display:flex;flex-direction:column;gap:18px;margin-top:26px\" novalidate>\n      <div class=\"field\">\n        <label for=\"name\">Full Name</label>\n        <input id=\"name\" name=\"name\" type=\"text\" placeholder=\"Your full name\" autocomplete=\"name\" required>\n      </div>\n      <div class=\"field\">\n        <label for=\"email\">Email</label>\n        <input id=\"email\" name=\"email\" type=\"email\" placeholder=\"you@email.com\" autocomplete=\"email\" required>\n      </div>\n      <div class=\"field\">\n        <label for=\"phone\">Phone</label>\n        <div class=\"phone-row\">\n          <span class=\"cc\">+44</span>\n          <input id=\"phone\" name=\"phone\" type=\"tel\" placeholder=\"7123 456789\" autocomplete=\"tel-national\" required>\n        </div>\n      </div>\n      <p id=\"form-error\" role=\"alert\" style=\"display:none;font-size:14px;color:#FF7070;font-weight:600\"></p>\n      <button type=\"submit\" class=\"btn\" style=\"width:100%;margin-top:6px\">Watch The Video Now\n        <svg class=\"arr\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg>\n      </button>\n      <p style=\"font-size:13px;color:var(--dim);text-align:center\">Your details are safe with us. No spam, ever.</p>\n    </form>\n  </div>\n</div>\n\n<!-- LIGHTBOX -->\n<div class=\"lb\" id=\"lb\" role=\"dialog\" aria-modal=\"true\" aria-label=\"Transformation viewer\">\n  <button type=\"button\" class=\"lb-btn\" id=\"lb-prev\" aria-label=\"Previous transformation\">\n    <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M15 18L9 12l6-6\"/></svg>\n  </button>\n  <div style=\"position:relative\">\n    <img class=\"lb-img\" id=\"lb-img\" src=\"\" alt=\"Lean Body Academy client transformation, full size\">\n    <span class=\"lb-count\" id=\"lb-count\"></span>\n  </div>\n  <button type=\"button\" class=\"lb-btn\" id=\"lb-next\" aria-label=\"Next transformation\">\n    <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M9 18l6-6-6-6\"/></svg>\n  </button>\n  <button type=\"button\" class=\"lb-btn lb-close\" id=\"lb-close\" aria-label=\"Close\">\n    <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M18 6L6 18M6 6l12 12\"/></svg>\n  </button>\n</div>\n\n<script>\n(function () {\n  var cfg = window.FUNNEL_CONFIG || {};\n  document.getElementById('yr').textContent = new Date().getFullYear();\n  var pad = function (v) { return v < 10 ? '0' + v : '' + v; };\n\n  // Opt in pop up\n  var wrap = document.getElementById('optin-wrap'), lastFocus = null;\n  function openOptin() {\n    lastFocus = document.activeElement;\n    wrap.classList.add('open');\n    document.body.style.overflow = 'hidden';\n    setTimeout(function () { document.getElementById('name').focus(); }, 50);\n  }\n  function closeOptin() {\n    wrap.classList.remove('open');\n    document.body.style.overflow = '';\n    if (lastFocus) lastFocus.focus();\n  }\n  Array.prototype.forEach.call(document.querySelectorAll('[data-optin]'), function (el) { el.addEventListener('click', openOptin); });\n  document.getElementById('optin-close').addEventListener('click', closeOptin);\n  wrap.addEventListener('click', function (e) { if (e.target === wrap) closeOptin(); });\n\n  var form = document.getElementById('optin'), err = document.getElementById('form-error');\n  form.addEventListener('submit', function (e) {\n    e.preventDefault();\n    var name = form.name.value.trim(), email = form.email.value.trim(), phone = form.phone.value.trim();\n    var msg = '';\n    if (!name) msg = 'Please enter your name.';\n    else if (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) msg = 'Please enter a valid email.';\n    else if (phone.replace(/\\D/g, '').length < 9) msg = 'Please enter a valid phone number.';\n    if (msg) { err.textContent = msg; err.style.display = 'block'; return; }\n    err.style.display = 'none';\n\n    var fullPhone = '+44' + phone.replace(/\\D/g, '').replace(/^0/, '');\n    var lead = { name: name, email: email, phone: fullPhone, source: 'lean-body-vsl', submittedAt: new Date().toISOString() };\n    try { sessionStorage.setItem('lb_lead', JSON.stringify(lead)); } catch (x) {}\n    if (cfg.dashboardFormsUrl && cfg.dashboardClient) {\n      // Sent as a normal form post so it goes through without a CORS check, even as the page moves on.\n      var fd = new URLSearchParams({\n        client: cfg.dashboardClient, source: 'magnet', form: 'VSL opt in', page: location.pathname,\n        utm_campaign: new URLSearchParams(location.search).get('utm_campaign') || '',\n        name: name, email: email, phone: fullPhone\n      });\n      try { fetch(cfg.dashboardFormsUrl, { method: 'POST', mode: 'no-cors', keepalive: true, body: fd }); } catch (x) {}\n    }\n    if (cfg.leadWebhookUrl) {\n      try { fetch(cfg.leadWebhookUrl, { method: 'POST', mode: 'no-cors', keepalive: true, headers: { 'Content-Type': 'text/plain' }, body: JSON.stringify(lead) }); } catch (x) {}\n    }\n    form.querySelector('button[type=submit]').disabled = true;\n    window.location.href = 'watch.html?' + new URLSearchParams({ name: name, email: email, phone: fullPhone }).toString();\n  });\n\n  // Collage\n  // Written out in full so tools that rewrite relative image paths (e.g. the REPS dashboard preview) can find them.\n  var images = [\n    'assets/img/t01.jpg', 'assets/img/t02.jpg', 'assets/img/t03.jpg', 'assets/img/t04.jpg', 'assets/img/t05.jpg',\n    'assets/img/t06.jpg', 'assets/img/t07.jpg', 'assets/img/t08.jpg', 'assets/img/t09.jpg', 'assets/img/t10.jpg',\n    'assets/img/t11.jpg', 'assets/img/t12.jpg', 'assets/img/t13.jpg'\n  ];\n  var big = [0, 3, 7, 9, 12];\n  var collage = document.getElementById('collage');\n  images.forEach(function (src, i) {\n    var b = document.createElement('button');\n    b.type = 'button';\n    b.className = 'tile t' + ((i % 4) + 1) + (big.indexOf(i) > -1 ? ' big' : '');\n    b.setAttribute('aria-label', 'Open transformation ' + (i + 1));\n    b.innerHTML = '<img src=\"' + src + '\" alt=\"Lean Body Academy client before and after transformation ' + (i + 1) + '\" loading=\"lazy\">' +\n      '<span class=\"ov\"><span class=\"tag\">Client ' + pad(i + 1) + '</span><span class=\"zoom\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#070707\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"M21 21l-4.3-4.3M11 8v6M8 11h6\"/></svg></span></span>';\n    b.addEventListener('click', function () { openLb(i); });\n    collage.appendChild(b);\n  });\n\n  // Lightbox\n  var lb = document.getElementById('lb'), lbImg = document.getElementById('lb-img'), lbCount = document.getElementById('lb-count');\n  var cur = 0, lbFocus = null;\n  function show(i) {\n    cur = (i + images.length) % images.length;\n    lbImg.src = images[cur];\n    lbCount.textContent = pad(cur + 1) + ' / ' + pad(images.length);\n  }\n  function openLb(i) { lbFocus = document.activeElement; show(i); lb.classList.add('open'); document.body.style.overflow = 'hidden'; document.getElementById('lb-close').focus(); }\n  function closeLb() { lb.classList.remove('open'); document.body.style.overflow = ''; if (lbFocus) lbFocus.focus(); }\n  document.getElementById('lb-prev').addEventListener('click', function () { show(cur - 1); });\n  document.getElementById('lb-next').addEventListener('click', function () { show(cur + 1); });\n  document.getElementById('lb-close').addEventListener('click', closeLb);\n  lb.addEventListener('click', function (e) { if (e.target === lb) closeLb(); });\n\n  document.addEventListener('keydown', function (e) {\n    if (wrap.classList.contains('open') && e.key === 'Escape') { closeOptin(); return; }\n    if (!lb.classList.contains('open')) return;\n    if (e.key === 'Escape') closeLb();\n    if (e.key === 'ArrowLeft') show(cur - 1);\n    if (e.key === 'ArrowRight') show(cur + 1);\n  });\n})();\n</script>\n</body>\n</html>\n"}, {"path": "confirmed.html", "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Your Call Is Booked | Lean Body Academy</title>\n<meta name=\"robots\" content=\"noindex\">\n<link rel=\"icon\" href=\"assets/img/logo.png\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;500;600;700;800&display=swap\">\n<link rel=\"stylesheet\" href=\"assets/styles.css\">\n<script src=\"assets/config.js\"></script>\n</head>\n<body>\n\n<header class=\"nav\">\n  <div class=\"wrap\" style=\"justify-content:center\">\n    <img class=\"logo\" src=\"assets/img/logo.png\" alt=\"Lean Body Academy\">\n  </div>\n</header>\n\n<main>\n  <section style=\"position:relative;padding:90px 0 110px\">\n    <div class=\"photo-bg short\" aria-hidden=\"true\">\n      <img src=\"assets/img/josh.jpg\" alt=\"\">\n      <div class=\"tint\"></div>\n      <div class=\"fade\"></div>\n    </div>\n    <div class=\"wrap\" style=\"position:relative\">\n      <div style=\"max-width:620px;min-height:420px;display:flex;flex-direction:column;justify-content:center\">\n        <div class=\"pulse\" style=\"width:84px;height:84px;border-radius:50%;background:var(--red);display:flex;align-items:center;justify-content:center\">\n          <svg width=\"38\" height=\"38\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6L9 17l-5-5\"/></svg>\n        </div>\n        <h1 class=\"disp\" style=\"font-size:clamp(52px,7.6vw,114px);line-height:.92;margin-top:34px\">Your Call Is <span class=\"red\">Booked</span></h1>\n        <p id=\"lede\" style=\"font-size:19px;line-height:1.6;color:#D4D4D4;margin-top:22px;max-width:500px\">Nice one. There's just one more step to lock in your spot with Josh.</p>\n      </div>\n    </div>\n    <div class=\"wrap\" style=\"position:relative;max-width:900px;text-align:center\">\n      <div style=\"position:relative;margin-top:54px;background:var(--card);border:1px solid var(--line-2);border-radius:28px;padding:50px 46px;box-shadow:0 50px 100px -30px rgba(0,0,0,.95)\" class=\"form-card\">\n        <div class=\"card-top\" style=\"left:48px;right:48px\" aria-hidden=\"true\"></div>\n        <span class=\"pill\"><i></i>Final Step</span>\n        <h2 class=\"disp\" style=\"font-size:clamp(30px,3.6vw,46px);line-height:1.02;margin-top:20px\">Confirm Your Call On WhatsApp</h2>\n        <p class=\"muted\" style=\"font-size:17px;line-height:1.65;margin:16px auto 0;max-width:520px\">Tap below and send Josh the pre-filled message. Calls that aren't confirmed may be given to someone on the waiting list.</p>\n        <a class=\"btn\" id=\"wa\" href=\"#\" target=\"_blank\" rel=\"noopener\" style=\"margin-top:32px\">\n          <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M21 11.5a8.4 8.4 0 0 1-12.4 7.4L3 20.5l1.6-5.4A8.4 8.4 0 1 1 21 11.5z\"/></svg>\n          Confirm On WhatsApp\n        </a>\n      </div>\n    </div>\n  </section>\n\n  <section style=\"padding:100px 0 60px\">\n    <div class=\"wrap\">\n      <div style=\"text-align:center\">\n        <span class=\"pill\"><i></i>Before Your Call</span>\n        <h2 class=\"disp\" style=\"font-size:clamp(40px,5vw,72px);line-height:.98;margin-top:22px\">What Happens <span class=\"red\">Next</span></h2>\n      </div>\n      <div class=\"perks\" style=\"margin-top:52px\">\n        <div class=\"perk\"><div class=\"n disp\" style=\"font-size:52px\">01</div><h3>Confirm On WhatsApp</h3><p>Send Josh a quick message so he knows you're locked in.</p></div>\n        <div class=\"perk\"><div class=\"n disp\" style=\"font-size:52px\">02</div><h3>Check Your Inbox</h3><p>Your calendar invite and call link are on their way to your email.</p></div>\n        <div class=\"perk\"><div class=\"n disp\" style=\"font-size:52px\">03</div><h3>Show Up Ready</h3><p>Find somewhere quiet and come ready to talk about your goals.</p></div>\n      </div>\n    </div>\n  </section>\n\n  <section style=\"padding:60px 0 130px\">\n    <div class=\"wrap\" style=\"max-width:1080px\">\n      <h2 class=\"disp\" style=\"font-size:clamp(32px,3.6vw,52px);line-height:1;text-align:center\">While You Wait, Here's What's Possible</h2>\n      <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:30px;margin-top:64px\">\n        <div class=\"ph a\"><img src=\"assets/img/t04.jpg\" alt=\"Lean Body Academy client before and after transformation\" loading=\"lazy\"></div>\n        <div class=\"ph b\"><img src=\"assets/img/t10.jpg\" alt=\"Lean Body Academy client before and after transformation\" loading=\"lazy\"></div>\n        <div class=\"ph c\"><img src=\"assets/img/t06.jpg\" alt=\"Lean Body Academy client before and after transformation\" loading=\"lazy\"></div>\n      </div>\n    </div>\n  </section>\n</main>\n\n<footer class=\"footer\">\n  <div class=\"wrap\">\n    <img src=\"assets/img/logo.png\" alt=\"Lean Body Academy\">\n    <div><a href=\"#\">Privacy</a> <span style=\"padding:0 8px\">|</span> <a href=\"#\">Terms And Conditions</a></div>\n    <div>\u00a9 <span id=\"yr\">2026</span> Lean Body Academy</div>\n  </div>\n</footer>\n\n<script>\n(function () {\n  var cfg = window.FUNNEL_CONFIG || {};\n  document.getElementById('yr').textContent = new Date().getFullYear();\n\n  var p = new URLSearchParams(location.search), lead = {};\n  try { lead = JSON.parse(sessionStorage.getItem('lb_lead') || '{}'); } catch (x) {}\n  var name = p.get('invitee_full_name') || p.get('name') || lead.name || '';\n  var first = name ? name.split(' ')[0] : '';\n  if (first) document.getElementById('lede').textContent = 'Nice one, ' + first + \". There's just one more step to lock in your spot with Josh.\";\n\n  var wa = document.getElementById('wa');\n  if (cfg.whatsappNumber) {\n    var msg = cfg.whatsappMessage || '';\n    if (first) msg = msg.replace(/^Hi Josh,/, 'Hi Josh, it\\'s ' + first + '.');\n    wa.href = 'https://wa.me/' + cfg.whatsappNumber.replace(/\\D/g, '') + '?text=' + encodeURIComponent(msg);\n  } else {\n    wa.removeAttribute('target');\n    wa.addEventListener('click', function (e) { e.preventDefault(); alert('Add Josh\\'s WhatsApp number in assets/config.js'); });\n  }\n})();\n</script>\n</body>\n</html>\n"}, {"path": "watch.html", "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Watch The Video | Lean Body Academy</title>\n<meta name=\"robots\" content=\"noindex\">\n<link rel=\"icon\" href=\"assets/img/logo.png\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;500;600;700;800&display=swap\">\n<link rel=\"stylesheet\" href=\"assets/styles.css\">\n<script src=\"assets/config.js\"></script>\n</head>\n<body>\n\n<div style=\"position:relative\">\n  <div class=\"photo-bg short\" style=\"height:640px\" aria-hidden=\"true\">\n    <img src=\"assets/img/josh.jpg\" alt=\"\">\n    <div class=\"tint\"></div>\n    <div class=\"fade\"></div>\n  </div>\n\n  <header class=\"nav\" style=\"border-bottom:0\">\n    <div class=\"wrap\">\n      <img class=\"logo\" src=\"assets/img/logo.png\" alt=\"Lean Body Academy\">\n      <div class=\"steps\" aria-label=\"Step 2 of 3\">\n        <div class=\"step done\"><b><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#070707\" stroke-width=\"3.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6L9 17l-5-5\"/></svg></b><span>Details</span></div>\n        <div class=\"step-line on\" aria-hidden=\"true\"></div>\n        <div class=\"step now\"><b>2</b><span>Watch And Book</span></div>\n        <div class=\"step-line\" aria-hidden=\"true\"></div>\n        <div class=\"step\"><b>3</b><span>Confirm</span></div>\n      </div>\n    </div>\n  </header>\n\n  <main>\n    <!-- HEADING -->\n    <section style=\"position:relative;padding:70px 0 60px\">\n      <div class=\"wrap\">\n        <div style=\"max-width:640px\">\n          <span class=\"pill\"><i></i><span id=\"hello\">You're In</span></span>\n          <h1 class=\"disp\" style=\"font-size:clamp(48px,7vw,104px);line-height:.92;margin-top:26px\">Watch The <span class=\"red\">Full Video</span> Below</h1>\n          <p style=\"font-size:19px;line-height:1.6;color:#D4D4D4;margin-top:24px;max-width:520px\">Watch it all the way through, then book your free call with Josh underneath.</p>\n        </div>\n      </div>\n    </section>\n\n    <!-- VIDEO -->\n    <section style=\"position:relative;padding:20px 0 120px\">\n      <div class=\"wrap\" style=\"max-width:1060px\">\n        <div class=\"video-frame\" style=\"box-shadow:0 50px 100px -30px rgba(0,0,0,.95)\">\n          <div class=\"video\" id=\"video\">\n            <button type=\"button\" class=\"play pulse\" id=\"play\" aria-label=\"Play video\">\n              <svg width=\"36\" height=\"36\" viewBox=\"0 0 24 24\" fill=\"#fff\" aria-hidden=\"true\"><path d=\"M8 5v14l11-7z\"/></svg>\n            </button>\n            <span class=\"ph-label\" id=\"video-label\">[ Josh's VSL video ]</span>\n          </div>\n        </div>\n        <div style=\"display:flex;justify-content:center;margin-top:40px\">\n          <a href=\"#book\" style=\"display:inline-flex;align-items:center;gap:10px;font-size:15px;font-weight:700;color:#D4D4D4;text-decoration:none\">\n            Book your call below\n            <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#FF4545\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 5v14M6 13l6 6 6-6\"/></svg>\n          </a>\n        </div>\n      </div>\n    </section>\n\n    <!-- CALENDLY -->\n    <section id=\"book\" style=\"position:relative;padding:110px 0 120px;border-top:1px solid var(--line)\">\n      <div class=\"glow\" style=\"top:260px;width:900px;height:460px;opacity:.13\" aria-hidden=\"true\"></div>\n      <div class=\"wrap\" style=\"position:relative;max-width:1060px\">\n        <div style=\"text-align:center\">\n          <span class=\"pill\"><i></i>Next Step</span>\n          <h2 class=\"disp\" style=\"font-size:clamp(40px,5.4vw,80px);line-height:.95;margin-top:22px\">Book Your <span class=\"red\">Free Call</span> With Josh</h2>\n          <p class=\"muted\" style=\"font-size:18px;line-height:1.6;margin:20px auto 0;max-width:600px\">Pick a time that suits you. Josh will get to know your goals and show you exactly how he'd get you into the best shape of your life.</p>\n        </div>\n\n        <div class=\"cal-card\" style=\"margin-top:52px\">\n          <div class=\"card-top\" style=\"left:48px;right:48px\" aria-hidden=\"true\"></div>\n          <div class=\"cal-inner\" id=\"cal\">\n            <div class=\"cal-ph\">\n              <div style=\"width:76px;height:76px;border-radius:22px;background:#FFE9E9;display:flex;align-items:center;justify-content:center\">\n                <svg width=\"36\" height=\"36\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#D12A2A\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"3\"/><path d=\"M16 2v4M8 2v4M3 10h18\"/><path d=\"M8 14h.01M12 14h.01M16 14h.01M8 18h.01M12 18h.01\"/></svg>\n              </div>\n              <p style=\"font-size:21px;font-weight:800\">Calendly goes here</p>\n              <p style=\"font-size:15px;line-height:1.6;color:#555;max-width:430px\">Add Josh's Calendly link to <strong>assets/config.js</strong> and his booking calendar will load in this panel.</p>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"perks\">\n          <div class=\"perk\"><div class=\"n disp\">01</div><h3>Free, No Pressure</h3><p>Just an honest chat about where you're at right now.</p></div>\n          <div class=\"perk\"><div class=\"n disp\">02</div><h3>One To One With Josh</h3><p>You'll speak with Josh directly, not a call centre.</p></div>\n          <div class=\"perk\"><div class=\"n disp\">03</div><h3>Leave With A Plan</h3><p>Know exactly what it'll take to hit your goal.</p></div>\n        </div>\n      </div>\n    </section>\n  </main>\n</div>\n\n<footer class=\"footer\">\n  <div class=\"wrap\">\n    <img src=\"assets/img/logo.png\" alt=\"Lean Body Academy\">\n    <div><a href=\"#\">Privacy</a> <span style=\"padding:0 8px\">|</span> <a href=\"#\">Terms And Conditions</a></div>\n    <div>\u00a9 <span id=\"yr\">2026</span> Lean Body Academy</div>\n  </div>\n</footer>\n\n<script>\n(function () {\n  var cfg = window.FUNNEL_CONFIG || {};\n  document.getElementById('yr').textContent = new Date().getFullYear();\n\n  // Details from the opt in (URL first, then session as a fallback)\n  var p = new URLSearchParams(location.search), lead = {};\n  try { lead = JSON.parse(sessionStorage.getItem('lb_lead') || '{}'); } catch (x) {}\n  var name = p.get('name') || lead.name || '', email = p.get('email') || lead.email || '', phone = p.get('phone') || lead.phone || '';\n  if (name) document.getElementById('hello').textContent = \"You're In, \" + name.split(' ')[0];\n\n  // Video: they've opted in, so the player loads straight away\n  var video = document.getElementById('video');\n  if (cfg.vslEmbedUrl) {\n    var src = cfg.vslEmbedUrl + (cfg.vslEmbedUrl.indexOf('?') > -1 ? '&' : '?') + 'playerColor=FF4545&seo=false';\n    video.innerHTML = '<iframe src=\"' + src.replace(/\"/g, '&quot;') + '\" allow=\"autoplay; fullscreen; picture-in-picture\" allowfullscreen title=\"Josh Bell: how to get in the best shape of your life\"></iframe>';\n  } else {\n    document.getElementById('play').addEventListener('click', function () {\n      document.getElementById('video-label').textContent = 'Add the VSL link in assets/config.js';\n    });\n  }\n\n  if (!cfg.calendlyUrl) return;\n\n  // Calendly inline embed with name, email and phone (first custom answer) prefilled\n  var q = new URLSearchParams({ hide_gdpr_banner: '1', background_color: 'ffffff', primary_color: 'ff4545' });\n  if (name) q.set('name', name);\n  if (email) q.set('email', email);\n  if (phone) q.set('a1', phone);\n  var url = cfg.calendlyUrl + (cfg.calendlyUrl.indexOf('?') > -1 ? '&' : '?') + q.toString();\n\n  document.getElementById('cal').innerHTML = '<div class=\"calendly-inline-widget\" data-url=\"' + url.replace(/\"/g, '&quot;') + '\"></div>';\n  var s = document.createElement('script');\n  s.src = 'https://assets.calendly.com/assets/external/widget.js';\n  s.async = true;\n  document.body.appendChild(s);\n\n  // Send them to the confirmation page as soon as a booking is made\n  window.addEventListener('message', function (e) {\n    if (e.origin.indexOf('calendly.com') === -1 || !e.data || e.data.event !== 'calendly.event_scheduled') return;\n    window.location.href = 'confirmed.html' + (name ? '?name=' + encodeURIComponent(name) : '');\n  });\n})();\n</script>\n</body>\n</html>\n"}]}